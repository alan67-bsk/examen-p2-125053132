# Copia este archivo como .env y cambia la contraseña:
#   cp .env.example .env
# El .env real no se sube al repositorio (esta en .gitignore)

# PostgreSQL
POSTGRES_USER=datamart
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=datamart

# La api se conecta a la base por el nombre del servicio del compose
DB_HOST=db
DB_PORT=5432

# Puerto de tu maquina por donde se consulta la api
# (en Mac el 5000 normalmente lo ocupa AirPlay, por eso uso el 5001)
API_PORT=5001
